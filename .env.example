# Little Learner's Club environment variables
#
# Copy this file to .env.local and fill in real values.
# Never commit real secrets. Use separate values for local, preview, and
# production environments.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser and must NOT
# contain secrets. Everything else is server-only.

# --- Application ---
# Public base URL of the app for the current environment. Must be http(s).
#
# This is also what every canonical URL, Open Graph URL, sitemap entry, and the
# robots.txt sitemap line are built from (src/lib/seo.ts), and the base for the
# auth confirmation/reset email links (…/auth/confirm). A deployment that leaves
# it at the default will publish localhost URLs to search engines and social
# previews, so set it correctly in preview and production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# One of: local | preview | production
APP_ENV="local"

# --- Authentication (Supabase Auth) ---
# Parent email + password authentication (see docs/AUTH.md). Read today by
# src/lib/env.ts.
#
# BOTH are optional in `local` and BOTH are REQUIRED when APP_ENV is `preview`
# or `production` — the build fails without them. They must be set together
# (both or neither); a half-configured client cannot talk to Supabase.
#
# Left blank in local development, the app uses a signed-cookie development
# stand-in for auth (non-secure, local-only). Set them to a Supabase project
# (hosted, or `supabase start`) to use real authentication locally, and add
# `<NEXT_PUBLIC_APP_URL>/auth/confirm` to that project's Auth → URL
# Configuration redirect allow-list.
#
# Client-safe project URL and anon key (http allowed only in local; https in
# preview/production).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Database / Supabase service access ---
# Server-only. Full access — never expose to the client. Backs the family data
# store (child profiles, lesson progress, mission completions — see
# docs/DATABASE.md). Read today by src/lib/env.ts.
#
# Together with NEXT_PUBLIC_SUPABASE_URL this makes the database "configured":
# OPTIONAL in `local` (unset, the app uses an in-memory stand-in) and REQUIRED
# when APP_ENV is `preview` or `production` — the build fails without it, and the
# in-memory stand-in is forbidden there.
SUPABASE_SERVICE_ROLE_KEY=""
# Server-only direct database connection string. NOT used: the family store
# reaches PostgreSQL through the Supabase client (URL + service-role key) rather
# than a direct connection. Kept as a placeholder for tooling that wants it.
DATABASE_URL=""

# --- Stripe (web subscriptions) ---
# Family subscriptions (see docs/BILLING.md). Read today by src/lib/env.ts.
#
# OPTIONAL in every environment — including production — because the subscription
# flow is intentionally not launched until families have tested the learning
# experience. Left unset, the app runs with billing OFF: everyone is on the free
# plan, checkout and the portal report "not available", and the webhook returns
# 503. Billing turns ON only when all four server-only values below are present.
#
# Use SEPARATE keys per environment, and never a live key in local or preview.

# Client-safe publishable key. Must be a pk_ key — env validation refuses a
# secret (sk_/rk_) key here, because this value reaches the browser. Optional.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Server-only secret key (sk_test_… in test mode). Never expose to the client.
STRIPE_SECRET_KEY=""
# Server-only webhook signing secret (whsec_…). From the Stripe dashboard, or
# printed by `stripe listen` when forwarding webhooks locally.
STRIPE_WEBHOOK_SECRET=""
# Server-only Stripe Price IDs for the two family plans (monthly and annual).
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_ANNUAL=""

# ---------------------------------------------------------------------------
# Everything below is NOT read yet. These are placeholders for later slices
# (analytics) and are ignored by the current build.
# ---------------------------------------------------------------------------

# --- Analytics (first-party) ---
# Optional server-only key for the first-party analytics sink.
ANALYTICS_WRITE_KEY=""
